#!/bin/bash
# Launch a Windows 7 utility installed by wine/install-apps.sh.
# Converts Linux paths from Dolphin/Open With into Wine paths.
#
# Usage: win7app-run <appname> <app.exe> [files...]
set -e

APPNAME="${1:?app name}"
APPEXE="${2:?app exe}"
shift 2

DATA_DIR="$HOME/.win7games-proton"
export WINEPREFIX="$DATA_DIR/pfx"
export WINEDEBUG="${WINEDEBUG:--all}"

find_proton() {
    if [ -n "${PROTON_DIR:-}" ] && [ -x "$PROTON_DIR/files/bin/wine" ]; then
        printf '%s\n' "$PROTON_DIR"; return 0
    fi
    local base d
    local -a cands=()
    for base in "$HOME/.local/share/Steam/steamapps/common" \
                "$HOME/.steam/root/steamapps/common" \
                "$HOME/.steam/steam/steamapps/common" \
                /d/SteamLibrary/steamapps/common \
                /c/SteamLibrary/steamapps/common; do
        [ -d "$base" ] || continue
        for d in "$base"/Proton*; do
            [ -x "$d/files/bin/wine" ] || continue
            cands+=("$d")
        done
    done
    [ ${#cands[@]} -eq 0 ] && return 1
    local stable
    stable=$(printf '%s\n' "${cands[@]}" | grep -E '/Proton [0-9]' | sort -V | tail -1)
    [ -n "$stable" ] && { printf '%s\n' "$stable"; return 0; }
    printf '%s\n' "${cands[@]}" | grep -E 'Experimental' | head -1 && return 0
    printf '%s\n' "${cands[0]}"
}

PROTON_DIR="$(find_proton)" || {
    echo "No working Proton runtime found." >&2
    exit 1
}
export LD_LIBRARY_PATH="$PROTON_DIR/files/lib64:$PROTON_DIR/files/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Proton symlinks its builtins into the prefix; repoint links left behind by a
# removed or updated Proton build, otherwise Wine cannot load kernel32.dll.
if [ -n "$(find "$WINEPREFIX/drive_c" -xtype l -print -quit 2>/dev/null)" ]; then
    while IFS= read -r -d '' link; do
        target=$(readlink "$link") || continue
        case "$target" in
            */files/*)
                new="$PROTON_DIR/files/${target#*/files/}"
                [ -e "$new" ] && ln -sfn "$new" "$link"
                ;;
        esac
    done < <(find "$WINEPREFIX/drive_c" -xtype l -print0 2>/dev/null)
fi

# Apps whose failure was a Wine builtin stub, fixed by using the Windows 7 DLL
# that the installer copied next to the exe.
case "$APPNAME" in
    osk)     export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}duser=n;dui70=n" ;;
    wordpad) export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}uiribbon=n" ;;
    paint)   export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}uiribbon=n" ;;
esac

APPDIR="$WINEPREFIX/drive_c/Program Files/Windows 7 Apps/$APPNAME"
[ -f "$APPDIR/$APPEXE" ] || { echo "Not installed: $APPDIR/$APPEXE" >&2; exit 1; }

args=()
for a in "$@"; do
    if [ -e "$a" ]; then
        abs="$(readlink -f "$a")"
        args+=("$("$PROTON_DIR/files/bin/winepath" -w "$abs" 2>/dev/null || printf '%s' "$abs")")
    else
        args+=("$a")
    fi
done

exec "$PROTON_DIR/files/bin/wine" "$APPDIR/$APPEXE" "${args[@]}"
